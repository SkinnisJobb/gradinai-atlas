#
# WHAT GITLAB ENFORCES, once the settings in atlas-cicd/gitlab-settings.md exist:
#   * Protected environments: only the people listed under "Allowed to deploy" can run a
#     deploy job for @@GATED_ENVS@@, and (on tiers that have it) the required approvals
#     must be given first. That is the gate; it holds whatever this file says.
#   * DEPLOY_CREDENTIAL is a MASKED CI/CD variable scoped to ONE environment, and PROTECTED
#     (only pipelines on protected branches and tags see it) for every environment whose
#     branches are protected. A job that does not deploy to that environment never receives
#     it, so an edited job cannot borrow another environment's credential.
#   * Protected branches: no push and no force push to an environment's branches; a merge
#     request with an approval and a green pipeline instead.
# WHAT IS CONVENTION (this file states it; whoever can edit the file can change it):
#   * `when: manual` on a gated deploy: the job waits for a person to start it. Without a
#     protected environment anyone with Developer access could press the button, which is
#     why the protected environment above is the real gate;
#   * which checks may fail without stopping a deploy (`allow_failure: true`);
#   * the triggers (`workflow:rules`, each job's `rules`) and the stage order.
#
# THE GUARDRAILS this follows: agents never hold a deploy credential, and agents never deploy
# to production (@@PROD_ENVS@@): that deploy waits for a person. Deploy jobs never run in a
# merge request pipeline, so a branch an agent pushed cannot reach an environment's variables.
# @@PROMOTION@@
@@CRUNCH_NOTE@@

workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS'
      when: never
    - if: '$CI_COMMIT_BRANCH'
    - if: '$CI_COMMIT_TAG'

stages:
  - check
  - deploy

