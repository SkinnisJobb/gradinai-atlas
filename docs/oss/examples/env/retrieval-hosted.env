# Example: semantic retrieval through a HOSTED embeddings endpoint (Azure OpenAI or Azure AI
# Foundry). A fragment layered over deploy/oss/.env.example after env/minimal.env. Start the
# stack with the overlay: docker compose -f docker-compose.yml -f retrieval.yml up -d
# The key is the file deploy/oss/secrets/embed_key (the overlay mounts it); never a variable.
# Another host file is chosen with ATLAS_EMBED_KEY_SOURCE. For an endpoint that takes Entra ID
# tokens instead of a key, see env/retrieval-entra.env.

# Turn the retrieval add-on on (off when unset).
ATLAS_RETRIEVAL=on
# The endpoint's embeddings URL; a URL ending in /embeddings is used as given, query included.
ATLAS_EMBED_URL=https://embeddings.example.org/openai/deployments/text-embedding-3-small/embeddings?api-version=2024-10-21
# The embedding model; changing it later re-indexes everything.
ATLAS_EMBED_MODEL=text-embedding-3-small
# The vector length this model returns.
ATLAS_EMBED_DIM=1536
# The PATH of the file holding the endpoint's key, inside the container.
ATLAS_EMBED_KEY_FILE=/run/secrets/embed_key
# Azure OpenAI takes the key in its api-key header.
ATLAS_EMBED_AUTH_HEADER=api-key
# Never send the text of a privately marked project to the endpoint.
ATLAS_EMBED_SCOPE=shared
