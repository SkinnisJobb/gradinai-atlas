# Example: the optional MCP gateway (AgentGateway in front of atlas-mcp) on its own HTTPS port.
# A fragment layered over deploy/oss/.env.example after env/minimal.env. Before starting it,
# render the gateway's configuration once, in deploy/oss:
#   python3 ../../scripts/render-gateway.py
# ATLAS_MCP_ALLOWED_HOSTS from env/minimal.env already admits atlas-mcp:9444, the gateway's hop.

# Start the gateway profile with every `docker compose up` (no --profile flag needed).
# To run the backup profile too, list both: COMPOSE_PROFILES=gateway,backup
COMPOSE_PROFILES=gateway
# The port agents connect to: https://<your host>:8444/mcp
ATLAS_GATEWAY_PORT=8444
# The interface the gateway's door listens on; 0.0.0.0 is every interface.
ATLAS_GATEWAY_BIND=0.0.0.0
