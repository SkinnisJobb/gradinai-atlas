# Example: the minimal profile. A fragment layered over deploy/oss/.env.example (see
# docs/oss/examples/README.md for how to apply it). It sets only what every install must change:
# the name the install answers on and the mailbox the privacy page names. Everything else keeps
# the value .env.example gives it (project RBAC, private by default, local accounts, secrets as
# files only). CI boots exactly this profile and signs in at /auth/login.
#
# No secret here or in any fragment: secrets are files under deploy/oss/secrets/, written by
# scripts/init-secrets.sh and passed to the containers as compose secrets.

# The DNS name people and agents use, without scheme or port. The TLS certificate is made for it.
ATLAS_PUBLIC_HOST=atlas.example.org
# The one absolute URL Atlas is reached on; the login origins and Bearer hosts derive from it.
ATLAS_PUBLIC_URL=https://atlas.example.org
# The Host headers atlas-mcp answers on /mcp: the public name, loopback for its own health
# probe, and atlas-mcp:9444 for the optional gateway profile.
ATLAS_MCP_ALLOWED_HOSTS=atlas.example.org,atlas.example.org:443,localhost:*,127.0.0.1:*,atlas-mcp:9444
# The browser origins atlas-mcp accepts when a request carries an Origin header.
ATLAS_MCP_ALLOWED_ORIGINS=https://atlas.example.org
# The mailbox the privacy page names.
ATLAS_PRIVACY_CONTACT=privacy@example.org
