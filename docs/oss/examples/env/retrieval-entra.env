# Example: semantic retrieval through Azure OpenAI or Azure AI Foundry with an Entra ID token
# instead of a key, the token coming from a federated WORKLOAD IDENTITY (AKS or another
# federated host). A fragment layered over deploy/oss/.env.example after env/minimal.env. Start
# the stack with both overlays, in deploy/oss:
#   docker compose -f docker-compose.yml -f retrieval.yml -f retrieval-workload-identity.yml up -d
# retrieval-workload-identity.yml mounts the token's directory read-only and points
# AZURE_FEDERATED_TOKEN_FILE into it. With a MANAGED identity (an Azure VM, App Service,
# Container Apps) leave that overlay and the three AZURE_* lines out: the add-on finds it itself.
# No key and no secret here: the federated token file is written and rotated by the platform.

# Turn the retrieval add-on on (off when unset).
ATLAS_RETRIEVAL=on
# The endpoint's embeddings URL; a URL ending in /embeddings is used as given, query included.
ATLAS_EMBED_URL=https://embeddings.example.org/openai/deployments/text-embedding-3-small/embeddings?api-version=2024-10-21
# The embedding model; changing it later re-indexes everything.
ATLAS_EMBED_MODEL=text-embedding-3-small
# The vector length this model returns.
ATLAS_EMBED_DIM=1536
# Authenticate with an Entra ID token, not a key (ATLAS_EMBED_KEY_FILE stays unset).
ATLAS_EMBED_AUTH_HEADER=entra
# The token scope; this is the default for Azure OpenAI in the public cloud.
ATLAS_EMBED_ENTRA_SCOPE=https://cognitiveservices.azure.com/.default
# No key file: retrieval.yml's embed_key secret becomes an empty mount nothing reads.
ATLAS_EMBED_KEY_SOURCE=/dev/null
# The directory tenant of the workload identity (not a secret).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# The client id of the app registration or managed identity the federated credential is on.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# The HOST directory holding the federated token file (azure-identity-token), readable by
# atlas-api's UID; the overlay mounts the directory, so a rotated token is seen.
AZURE_FEDERATED_TOKEN_DIR=/var/run/secrets/azure/tokens
# Never send the text of a privately marked project to the endpoint.
ATLAS_EMBED_SCOPE=shared
