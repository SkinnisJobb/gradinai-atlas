# Example: semantic retrieval through an embedding server you run yourself on your own network
# (any OpenAI-compatible /v1/embeddings server), over TLS with a certificate from this install's
# CA. A fragment layered over deploy/oss/.env.example after env/minimal.env. Start the stack
# with the overlay: docker compose -f docker-compose.yml -f retrieval.yml up -d
# The overlay mounts the key file deploy/oss/secrets/embed_key and the install CA.

# Turn the retrieval add-on on (off when unset).
ATLAS_RETRIEVAL=on
# The server's OpenAI-compatible base; /embeddings is appended to a /v1 base. https is required.
ATLAS_EMBED_URL=https://embed.example.org/v1
# The model the server serves; changing it later re-indexes everything.
ATLAS_EMBED_MODEL=bge-m3
# The vector length this model returns.
ATLAS_EMBED_DIM=1024
# The PATH of the file holding the server's key, inside the container.
ATLAS_EMBED_KEY_FILE=/run/secrets/embed_key
# Send the key as Authorization: Bearer.
ATLAS_EMBED_AUTH_HEADER=bearer
# Check the server's certificate against this install's CA (mounted by retrieval.yml).
ATLAS_EMBED_CA_BUNDLE=/run/secrets/atlas_ca
# Never send the text of a privately marked project to the server.
ATLAS_EMBED_SCOPE=shared
# Texts per embeddings call; lower it for a small GPU.
ATLAS_EMBED_BATCH=16
# Seconds between indexing passes.
ATLAS_RETRIEVAL_INTERVAL_S=60
# How many nodes the vector list contributes to a semantic or hybrid search (1-200).
ATLAS_RETRIEVAL_TOP_K=30
