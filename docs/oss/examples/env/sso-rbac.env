# Example: single sign-on through an OIDC identity provider, with project roles (RBAC).
# A fragment layered over deploy/oss/.env.example after env/minimal.env. The provider here is a
# Keycloak realm; for Entra ID use the issuer https://login.microsoftonline.com/<tenant-id>/v2.0
# and ATLAS_OIDC_PRESET=entra. Register Atlas in the provider as a confidential client
# (authorization code + PKCE) with the redirect URI https://<your host>/auth/oidc/callback.
#
# Start the stack with the shipped SSO overlay, in deploy/oss:
#   docker compose -f docker-compose.yml -f oidc.yml up -d
# oidc.yml gives atlas-api its route to the provider and mounts the client secret and the group
# map as FILES: ./secrets/oidc_client_secret at /run/secrets/oidc_client_secret and
# ./secrets/oidc_group_map.yml at /run/secrets/oidc_group_map. Another host file is chosen with
# ATLAS_OIDC_CLIENT_SECRET_SOURCE / ATLAS_OIDC_GROUP_MAP_SOURCE (see .env.example); the defaults
# are used here. Never put the client secret in this file: the plain variable is refused.

# Offer single sign-on only: the login page shows "Sign in with SSO".
ATLAS_AUTH_PROVIDERS=oidc
# Password login only for break-glass accounts (made with `atlas-admin user add ... --break-glass`).
ATLAS_LOCAL_LOGIN=break-glass
# The provider's issuer URL; discovery is read from <issuer>/.well-known/openid-configuration.
ATLAS_OIDC_ISSUER=https://sso.example.org/realms/atlas
# The claim names this provider uses: generic, entra or keycloak.
ATLAS_OIDC_PRESET=keycloak
# The client id of Atlas's registration in the provider (not a secret).
ATLAS_OIDC_CLIENT_ID=atlas
# How Atlas authenticates at the token endpoint: with the client secret, in a Basic header.
ATLAS_OIDC_TOKEN_AUTH=client_secret_basic
# The PATH of the file holding the client secret, inside the container (oidc.yml mounts it).
ATLAS_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# The scopes requested at sign-in; openid is required.
ATLAS_OIDC_SCOPES=openid profile email
# The allowlist mapping provider groups to Atlas groups (your copy of sso/oidc-group-map.yml,
# mounted by oidc.yml without its .yml suffix).
ATLAS_OIDC_GROUP_MAP_FILE=/run/secrets/oidc_group_map
# A person must hold this provider group to sign in; their account is made at first sign-in.
ATLAS_OIDC_REQUIRED_GROUPS=/atlas/users
# An SSO session lasts at most this many hours.
ATLAS_OIDC_MAX_SESSION_HOURS=12
# A person's agent tokens stop working this many days after their last SSO sign-in.
ATLAS_OIDC_REVALIDATE_DAYS=30
# An SSO person creates their own agent credentials by signing in again at the provider
# (step-up) instead of with a password they do not have. Off when unset.
ATLAS_OIDC_STEP_UP=on
# That fresh sign-in counts for this many seconds (60-900). Entra ID: add the optional claim
# auth_time to the ID token.
ATLAS_OIDC_STEP_UP_MAX_AGE_SECONDS=300
# Project roles: access is granted per project.
ATLAS_RBAC=projects
# A new project is private: only the people and groups bound to it see it.
ATLAS_DEFAULT_PROJECT_VISIBILITY=private
# On a shared project everyone else holds this role (read-only).
ATLAS_SHARED_PROJECT_ROLE=viewer
# An instance owner is not implicitly owner of every project.
ATLAS_INSTANCE_ADMIN_IMPLICIT_PROJECT_OWNER=false
