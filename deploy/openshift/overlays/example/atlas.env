# The example overlay's atlas-env settings (TASK-1496), merged over deploy/openshift/base/atlas.env:
# a key here replaces the base's value, a key not here keeps it. NO SECRET GOES HERE (the base
# file says why); secrets are files, made by scripts/openshift/new-secrets.py.
#
# After changing this file on a running install: `oc apply -k` again, then
# `oc rollout restart deploy/atlas-api deploy/atlas-mcp` (atlas-env has no content hash, so a
# change does not roll the pods by itself).

# 3. THE PUBLIC HOST: the name people and agents use, the Route's host (copied from here by the
# overlay's `replacements:`). On the router's default certificate it must be ONE label under the
# cluster's apps domain, `atlas.<apps domain>`; read that domain with
#   oc get ingresses.config cluster -o jsonpath='{.spec.domain}'
# The same name goes in all four lines. No port: the router serves 443.
ATLAS_PUBLIC_HOST=atlas.change-me.example.com
ATLAS_PUBLIC_URL=https://atlas.change-me.example.com
ATLAS_MCP_ALLOWED_HOSTS=atlas.change-me.example.com,atlas.change-me.example.com:443,localhost:*,127.0.0.1:*
ATLAS_MCP_ALLOWED_ORIGINS=https://atlas.change-me.example.com

# What the privacy page says. Describe your own install: the code's default describes another one.
ATLAS_PRIVACY_CONTACT=privacy@example.com
ATLAS_PRIVACY_HOSTING=One PostgreSQL database (CloudNativePG) in this organisation's own OpenShift cluster. It is not copied to a third party.

# What an EMPTY database is seeded with, read once at the first start: `demo` gives one neutral
# example project, so a first try shows a board with something on it. For an install that is to
# hold real work from day one, set `none` BEFORE the first `oc apply -k`; changing it later does
# nothing (the database is no longer empty), and the demo project is then archived by hand.
ATLAS_SEED=demo
