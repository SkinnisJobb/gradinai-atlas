# The `atlas-env` ConfigMap (TASK-1485): the OpenShift counterpart of deploy/oss/.env, loaded with
# `envFrom` by atlas-api and the migrate Job (and atlas-mcp, task 3.2). Defaults from the env
# mapping in docs/oss/research/openshift-aro.md; docs/oss/CONFIG.md describes every key.
#
# NO SECRET GOES HERE. A ConfigMap is readable by anyone who can read the namespace, and these keys
# reach the environment. Secrets are files: the *_FILE paths are fixed on the containers
# (deployment-api.yaml, job-migrate.yaml), and the openshift-lint conftest policy refuses a
# secret-shaped key (*_PEPPER, *_DB_URL, *_SECRET, *_KEY, *_TOKEN, *_PASSWORD) in a ConfigMap.
#
# The company overlay changes these with a generator of the same name and `behavior: merge`, from
# its own file (see deploy/openshift/README.md). atlas.example.com is a placeholder: the overlay
# MUST set ATLAS_PUBLIC_HOST, ATLAS_PUBLIC_URL and the two ATLAS_MCP_ALLOWED_* keys to the Route's
# host, and ATLAS_PRIVACY_CONTACT / ATLAS_PRIVACY_HOSTING to its own text.
#
# Fixed on the containers instead of here, so an overlay cannot drop them by accident: the *_FILE
# paths, PGSSLMODE / PGSSLROOTCERT, ATLAS_INTERNAL_HOSTS and ATLAS_TRUSTED_PROXY_CIDRS.

# Secrets from files only: atlas-api and atlas-migrate refuse ATLAS_DB_URL, ATLAS_*_PEPPER and the
# other plain forms. Required on OpenShift; an overlay must never turn it off. (It lives here, not
# on the containers, only because kube-linter's env-var-secret check flags any container variable
# whose name contains SECRET.)
ATLAS_REQUIRE_SECRET_FILES=1

# Names and the front door. No port in the URL: the router serves 443.
ATLAS_PUBLIC_HOST=atlas.example.com
ATLAS_PUBLIC_URL=https://atlas.example.com
# atlas-mcp:9444 (the compose gateway's door) is dropped: no gateway on OpenShift in v1.
ATLAS_MCP_ALLOWED_HOSTS=atlas.example.com,atlas.example.com:443,localhost:*,127.0.0.1:*
ATLAS_MCP_ALLOWED_ORIGINS=https://atlas.example.com
ATLAS_PRODUCT_NAME=Atlas

# What the install contains, and who sees what.
ATLAS_SEED=none
ATLAS_LEGACY_V0=0
ATLAS_PUBLIC_DOCS=1
ATLAS_RBAC=projects
ATLAS_DEFAULT_PROJECT_VISIBILITY=private
ATLAS_SHARED_PROJECT_ROLE=viewer
ATLAS_INSTANCE_ADMIN_IMPLICIT_PROJECT_OWNER=false

# Behaviour switches.
ATLAS_DISABLED_FEATURES=github_link,save_work,deploy_status,deploy_warning,attention_probes
ATLAS_BREACH_CHECK=bundled
ATLAS_ACCEPTANCE_AGENT_WRITE=off
ATLAS_STRICT_API=1
# With several replicas a board-set value is applied at each pod's boot; read-only until that is
# tested with replicas (research, env mapping).
ATLAS_CONFIG_WRITES=0
ATLAS_MCP_AUTH_CACHE_S=60

# Audit. The purge that enforces the retention is a CronJob (task 3.8).
ATLAS_AUDIT_READS=1
ATLAS_AUDIT_RETENTION_DAYS=365
